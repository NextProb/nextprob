{
  "name": "toutkit",
  "version": "0.1.0",
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "author": "Helicase Space LLC <contact@helicase.space>",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild",
    "cleanup:build": "rm -rf release/mac release/mac-arm64 release/mac-x64 release/win-unpacked release/builder-*.yaml release/builder-*.yml release/*.blockmap",
    "prebuild-config": "node scripts/prebuild-config.js",
    "dist:mac": "npm run prebuild-config && rm -rf release/* && electron-builder --mac && npm run cleanup:build",
    "dist:mac-no-notarize": "npm run prebuild-config && rm -rf release/* && cross-env SKIP_NOTARIZE=1 electron-builder --mac && npm run cleanup:build",
    "dist:mac-no-sign-notarize": "npm run prebuild-config && rm -rf release/* && cross-env SKIP_NOTARIZE=1 electron-builder --mac -c.mac.identity=null && npm run cleanup:build",
    "dist:mac-intel": "npm run prebuild-config && rm -rf release/* && cross-env SKIP_NOTARIZE=1 electron-builder --mac --x64 -c.mac.identity=null && npm run cleanup:build",
    "dist:win": "npm run prebuild-config && rm -rf release/* && electron-builder --win --x64 && npm run cleanup:build",
    "build:export-template": "node scripts/build-export-template.js",
    "licenses:generate": "npx --yes --package=generate-license-file@4.1.1 generate-license-file --input package.json --output THIRD_PARTY_LICENSES.md --overwrite"
  },
  "build": {
    "appId": "com.toutkit.app",
    "productName": "ToutKit",
    "npmRebuild": false,
    "directories": {
      "output": "release/"
    },
    "files": [
      "main.js",
      "preload.js",
      "bridge.js",
      "*.js",
      "*.css",
      "auth-config.json",
      "providers/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "export-app-template/dist/**/*",
      "terminal/**/*",
      "!tests/**",
      "!test-results/**",
      "!auto-steps/**",
      "!playwright.config.js"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "icon": "assets/icon",
    "afterSign": "scripts/notarize.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ToutKit needs microphone access so notes can record audio.",
        "NSCameraUsageDescription": "ToutKit needs camera access so notes can capture video."
      },
      "gatekeeperAssess": false,
      "artifactName": "ToutKit-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "archiver": "7.0.1",
    "better-sqlite3": "12.9.0",
    "chokidar": "3.6.0",
    "d3": "7.9.0",
    "dompurify": "3.4.0",
    "highlight.js": "11.11.1",
    "ignore": "7.0.5",
    "lunr": "2.3.9",
    "marked": "17.0.4",
    "node-pty": "1.1.0",
    "ssh2": "1.17.0",
    "turndown": "7.2.2",
    "turndown-plugin-gfm": "1.0.2",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "@electron/packager": "18.4.4",
    "@electron/rebuild": "4.0.4",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@playwright/test": "1.58.2",
    "cross-env": "7.0.3",
    "electron": "41.3.0",
    "electron-builder": "26.8.1"
  }
}
