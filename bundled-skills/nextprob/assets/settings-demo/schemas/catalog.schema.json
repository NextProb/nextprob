{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NextProb settings catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "definitions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "definitions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Publication revision, independent of the version 1 file format. Increment for every shipped catalog or schema change.",
      "maximum": 9007199254740991
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Minimum compatible application version for this catalog."
    },
    "agents": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\u0000).*[^/]$"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "group",
        "description",
        "match",
        "format",
        "views",
        "creation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "directories": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        },
        "format": {
          "enum": [
            "text",
            "markdown",
            "json",
            "line-rules",
            "ini",
            "toml",
            "jsonc"
          ]
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source",
              "preview",
              "structured",
              "rules"
            ]
          }
        },
        "creation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "initialText"
          ],
          "properties": {
            "mode": {
              "const": "explicit"
            },
            "initialText": {
              "type": "string"
            }
          }
        },
        "managedSections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "label"
            ],
            "properties": {
              "start": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "schema": {
          "$ref": "#/$defs/relativePath"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        },
        "discovery": {
          "$ref": "#/$defs/discovery"
        }
      }
    },
    "formNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "group",
            "field",
            "list",
            "map"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "children": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/formNode"
          }
        },
        "collapsed": {
          "type": "boolean"
        },
        "default": {},
        "mergeDefaults": {
          "type": "boolean"
        },
        "control": {
          "enum": [
            "text",
            "toggle",
            "select",
            "number",
            "lines",
            "json"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "emptyLabel": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {},
              "label": {
                "type": "string"
              }
            }
          }
        },
        "optionsFrom": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "clearOnChange": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "enum": [
                      "__proto__",
                      "prototype",
                      "constructor"
                    ]
                  }
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "visibleWhen": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "equals"
          ],
          "properties": {
            "path": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "enum": [
                        "__proto__",
                        "prototype",
                        "constructor"
                      ]
                    }
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "equals": {}
          }
        },
        "itemTitle": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "keyField": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "reorderable": {
          "type": "boolean"
        },
        "removable": {
          "type": "boolean"
        },
        "itemTemplate": {},
        "addLabel": {
          "type": "string"
        },
        "summary": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "group",
                  "list",
                  "map"
                ]
              }
            }
          },
          "then": {
            "required": [
              "title",
              "children"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "field",
                  "list",
                  "map"
                ]
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultView": {
          "enum": [
            "source",
            "structured",
            "preview",
            "rules"
          ]
        },
        "order": {
          "type": "integer"
        },
        "advanced": {
          "type": "boolean"
        },
        "layout": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/formNode"
          }
        },
        "editor": {
          "enum": [
            "document",
            "ini",
            "rules",
            "catalog"
          ]
        },
        "saveLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "createLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "emptyMessage": {
          "type": "string"
        },
        "iniFields": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title",
              "scope"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "scope": {
                "enum": [
                  "root",
                  "section"
                ]
              },
              "type": {
                "enum": [
                  "text",
                  "number"
                ]
              },
              "options": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "label"
                  ],
                  "properties": {
                    "value": {},
                    "label": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "group",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "advanced": {
          "type": "boolean"
        },
        "sections": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "definitions",
              "view"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "definitions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "view": {
                "enum": [
                  "resource",
                  "documents",
                  "packages",
                  "browser"
                ]
              },
              "description": {
                "type": "string"
              },
              "collapsed": {
                "type": "boolean"
              },
              "emptyMessage": {
                "type": "string"
              }
            }
          }
        },
        "agentCategory": {
          "enum": [
            "instructions",
            "skills",
            "settings",
            "resources"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "agentCategory"
            ]
          },
          "else": {
            "properties": {
              "sections": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "browser",
            "packages"
          ]
        },
        "packageFile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "exclude": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patterns",
              "reason"
            ],
            "properties": {
              "patterns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "packageViews": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "path"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\u0000).*[^/]$"
              }
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "instructions": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "settings": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    }
  }
}
